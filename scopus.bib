@ARTICLE{R2025815,
	author = {R, Arya M. and Beevy, S. Suhara and Dan, Mathew},
	title = {Morphological and Genetic Diversity of Indian Clitoria ternatea L. (Faboideae, Fabaceae) Morphotypes Inferred from Floral Characters and SCoT Markers},
	year = {2025},
	journal = {Plant Molecular Biology Reporter},
	volume = {43},

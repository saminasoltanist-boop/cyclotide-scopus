	pages = {1 - 12},
	doi = {10.1042/BJ20060627},
	url = {https://www.scopus.com/pages/publications/33751073415?origin=resultslist},
	affiliations = {Institute for Molecular Bioscience, Australian Research Council Special Research Centre for Functional and Applied Genomics, University of Queensland, Brisbane, QLD 4072, Australia; School of Business, University of Queensland, Brisbane, QLD 4072, Australia},
	abstract = {Cyclotides are a fascinating family of plant-derived peptides characterized by their head-to-tail cyclized backbone and knotted arrangement of three disulfide bonds. This conserved structural architecture, termed the CCK (cyclic cystine knot), is responsible for their exceptional resistance to thermal, chemical and enzymatic degradation. Cyclotides have a variety of biological activities, but their insecticidal activities suggest that their primary function is in plant defence. In the present study, we determined the cyclotide content of the sweet violet Viola odorata, a member of the Violaceae family. We identified 30 cyclotides from the aerial parts and roots of this plant, 13 of which are novel sequences. The new sequences provide information about the natural diversity of cyclotides and the role of particular residues in defining structure and function. As many of the biological activities of cyclotides appear to be associated with membrane interactions, we used haemolytic activity as a marker of bioactivity for a selection of the new cyclotides. The new cyclotides were tested for their ability to resist proteolysis by a range of enzymes and, in common with other cyclotides, were completely resistant to trypsin, pepsin and thermolysin. The results show that while biological activity varies with the sequence, the proteolytic stability of the framework does not, and appears to be an inherent feature of the cyclotide framework. The structure of one of the new cyclotides, cycloviolacin 014, was determined and shown to contain the CCK motif. This study confirms that cyclotides may be regarded as a natural combinatorial template that displays a variety of peptide epitopes most likely targeted to a range of plant pests and pathogens. © 2006 Biochemical Society.},
	author_keywords = {Cyclic cystine knot; Cyclotide; Cycloviolacin; Kalata Bl; Sequence variation; Viola odorata},
	keywords = {Amino Acid Sequence; Chromatography, Liquid; Cyclotides; Hemolysis; Humans; Models, Molecular; Molecular Sequence Data; Molecular Structure; Pepsin A; Plant Extracts; Sequence Homology, Amino Acid; Spectrometry, Mass, Matrix-Assisted Laser Desorption-Ionization; Thermodynamics; Thermolysin; Trypsin; Viola; Viola odorata; Violaceae; Association reactions; Bacteria; Biodiversity; Degradation; Derivatives; Electric resistance; cyclotide; amino acid sequence; article; controlled study; nonhuman; priority journal; protein analysis; protein function; protein interaction; protein stability; protein structure; proton nuclear magnetic resonance; viola odorata; Violaceae; Cyclic cystine knots; Cyclotides; Cycloviolacins; Sequence variations; Viola odorata; Polypeptides},
	correspondence_address = {D.J. Craik; Institute for Molecular Bioscience, Australian Research Council Special Research Centre for Functional and Applied Genomics, University of Queensland, Brisbane, QLD 4072, Australia; email: d.craik@imb.uq.edu.au},
	issn = {02646021},
	coden = {BIJOA},
	pmid = {16872274},
	language = {English},
	abbrev_source_title = {Biochem. J.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 179; All Open Access; Green Open Access}
}

@ARTICLE{Colgrave20045965,
	author = {Colgrave, Michelle L. and Craik, David J.},

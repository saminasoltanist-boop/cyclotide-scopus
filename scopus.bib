@BOOK{Abbas202477,
	author = {Abbas, Syed Kashif and Qadeer, Saira and Khan, Muhammad Jadoon and Abbas, Syed Tahir and Shah, Naseer Ali},
	title = {Plant-Based Peptides: Antibiotics},
	year = {2024},
	journal = {Recent Advances in Industrial Biochemistry},

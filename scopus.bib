@BOOK{Attah20233,
	author = {Attah, Alfred Francis and Kola-Mustapha, Adeola Tawakalitu},
	title = {Protecting the Endemism of Threatened Cyclotide-Rich Medicinal Plants: The Tropical African Experience},
	year = {2023},
	journal = {Sustainable Uses and Prospects of Medicinal Plants},
	pages = {3 - 17},
	doi = {10.1201/9781003206620-2},
	url = {https://www.scopus.com/pages/publications/85163567344?origin=resultslist},
	affiliations = {Department of Pharmacognosy and Drug Development, Faculty of Pharmaceutical Sciences, University of Ilorin, Ilorin, Nigeria; Department of Pharmacognosy and Drug Development, Faculty of Pharmaceutical Sciences, University of Ilorin, Kwara State, Ilorin, Nigeria},
	abstract = {Without plants as man’s co-tenants on earth, human life, which depends directly or indirectly on plants, will cease to exist. Tropical Africa is progressively undergoing an unprecedented threat to plant biodiversity. This is particularly true for cyclotide-producing plants from the Rubiaceae, Violaceae, and Fabaceae families endemic to the region. Cyclotides were first discovered from an African Rubiaceous plant family. They are naturally occurring low-molecular-weight peptides whose circular configuration and cystine knot arrangement is distinct among other bioactive peptides, and have found applications in medicine, agriculture, and in plant chemosystematics. However, many of the cyclotide-rich plants endemic to Africa are threatened by climate change, increasing population, land use, agriculture, unsustainable plant-based research, timber exploitation, and mining. Some cyclotide-rich plants have, therefore, been predicted to go extinct by the end of the 21st century. To better understand the ever-increasing threats to cyclotide-rich plants that are endemic to Africa, for the first time we document these endangered plants widely used in traditional medicine whose non-existent conservation status deserves urgent attention to forestall imminent extinction of these important bioresources. In this chapter, we propose strategies with potentials to minimize the continuing loss of cyclotide-rich plant diversity in Africa. © 2023 selection and editorial matter, Learnmore Kambizi and Callistus Bvenura; individual chapters, the contributors.},
	publisher = {CRC Press},
	isbn = {978-100084451-1; 978-103207173-2},
	language = {English},
	abbrev_source_title = {Sustainable Uses and Prospects of Medicinal Plants},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}


	author = {Forlemu, Neville Y. and Njabon, Eric N. and Mallia, Ajay and Mwongela, Simon and Tangirala, Sairam},
	title = {Molecular Dynamics Simulations Cyclotide Kalata B1 Interactions with Lipid Bilayers},
	year = {2026},
	journal = {Molecules},
	volume = {31},

	year = {2018},
	journal = {Scientific Reports},
	volume = {8},
	number = {1},
	pages = {},
	doi = {10.1038/s41598-018-28380-3},
	url = {https://www.scopus.com/pages/publications/85049526400?origin=resultslist},
	affiliations = {School of Biomedical Sciences, Faculty of Medicine, University of Queensland, Brisbane, 4072, QLD, Australia; Center for Physiology and Pharmacology, Medical University of Vienna, Schwarzspanierstrasse 17, Vienna, 1090, Austria; Victor Chang Cardiac Research Institute, Molecular Pharmacology Division, Lowy Packer Building, 405 Liverpool St, Darlinghurst, 2010, NSW, Australia},
	abstract = {The oxytocin/vasopressin signalling system is conserved across the animal kingdom. In insects, the role of oxytocin-type (inotocin) neuropeptides has only been studied in locusts, beetles and ants, but their physiology continues to be poorly understood. One reason for this knowledge deficit is the lack of available research tools to complement functional genomics efforts. Consequently, ligands to probe insect inotocin receptors are essential. In this study, we sought to identify novel agonists and antagonists of the inotocin receptor from the representative model species Tribolium castaneum and Lasius Niger. Drawing upon known ligands of the human receptors, we examined the pharmacology of the plant-derived cyclotide kalata B7 and the synthetic oxytocin analogue atosiban. Kalata B7 is a weak partial agonist of both inotocin receptors. This is the first reported direct interaction of cyclotides with an insect receptor, an observation that may explain their presumed role in herbivore defence. Furthermore, we discovered atosiban is an antagonist of the Tribolium receptor, which may provide a useful probe to investigate the functionality of inotocin signalling in beetles and related insect species. Our findings will enable further examination of insect inotocin receptor pharmacology and physiology, and may trigger studies to comprehend the interaction of plant cyclotides and insects. © 2018 The Author(s).},
	keywords = {Animals; Ants; Cyclotides; Hormone Antagonists; Oxytocin; Receptors, Oxytocin; Receptors, Vasopressin; Signal Transduction; Tribolium; Vasopressins; Vasotocin; argiprestocin; atosiban; cyclotide; hormone antagonist; kalata B7, Oldenlandia affinis; oxytocin; oxytocin receptor; vasopressin derivative; vasopressin receptor; animal; ant; drug effect; genetics; metabolism; signal transduction; Tribolium},

@ARTICLE{Jennings2005851,
	author = {Jennings, Cameron V. and Rosengren, K. Johan and Daly, Norelle L. and Plan, Manuel and Stevens, Jackie and Scanlon, Martin J. and Waine, Clement and Norman, David G. and Anderson, Marilyn A. and Craik, David J.},

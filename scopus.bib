	affiliations = {Department of Biochemistry, University College of Sciences, Osmania University, Hyderabad, Telangana, 500007, India; Department of Plant Sciences, School of Life Sciences, University of Hyderabad, Telangana, 500046, India},
	abstract = {Phytomedicine is a plant-based medicinal system involved in preventive, healing, and therapeutic procedures. The plant or botanical sources are acknowledged to deliver various modules or chemical entities for therapeutic, pharmacological, and nutritional requirements such as drugs, nutraceuticals (functional foods), proteins, and gum resins. Plant-derived small molecules such as digoxin, homoharringtonine (HHT)/omacetaxine mepesuccinate, paclitaxel, ingenol mebutate (ingenol-3-angelate), and ephedrine have been approved by recognized agencies for use with proven pharmacological efficacy and safety in the modern systems of medicine. Also, Sativex, sinecatechins, and crofelemer have been approved as botanical drugs, and myrrh, guggul, Frankincense/olibanum, and sweetgum resin have been approved as therapeutic resins/gums. A plethora of plant peptides have shown to have a beneficial and positive effect on human health. Various plant-derived bioactive antimicrobial peptides, for example, thionein, cyclotides, and knottin peptides, might open new avenues for the management of various diseases in the years to come. Although naturally occurring phytochemicals or plant derivatives such as epigallocatechin gallate (EGCG), curcumin, quercetin, resveratrol, apigenin, and anthocyanidins have been explored extensively for maintaining and promoting health, there are some apprehensions associated with the biocompatibility, solubility, inefficacy, toxicity, and low tissue distribution that present a huge challenge of employing them as medicine. Therefore a combination of phytobioactive compounds with the nanotechnology is a practical and advanced approach to address these limitations. Drug delivery modes with lower toxicity and greater efficiency have been made possible with the introduction of nanotechnology. Size cutting methods and technologies have yielded diverse nanostructures that demonstrate distinctive physicochemical and biological properties. Therefore synthesizing nanoparticles via biological entities especially plants offers a clean, nontoxic, and environment-friendly method of synthesis. It also produces safe therapeutic nanoparticles with a wide variety of sizes, shapes, and compositions. In this perspective, it becomes imperative to focus on the endeavors of contemporary research on the design and development of smart multifunctional phytonanocomposites and examine in vivo and clinical settings of their formulations. © 2021 Elsevier Inc. All rights reserved.},
	author_keywords = {Antioxidants; Bioactive compounds; Phytomedicine; Phytonanocomposites; Therapeutics},
	publisher = {Elsevier},
	isbn = {978-012824109-7},
	language = {English},
	abbrev_source_title = {Phytomedicine: A Treasure of Pharmacologically Active Products from Plants},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 9}
}


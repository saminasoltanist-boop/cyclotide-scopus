@ARTICLE{Gruber20103071,
	author = {Gruber, Christian W. and Muttenthaler, Markus and Freissmuth, Michael},
	title = {Ligand-based peptide design and combinatorial peptide libraries to target G protein-coupled receptors},
	year = {2010},
	journal = {Current Pharmaceutical Design},
	volume = {16},
	number = {28},
	pages = {3071 - 3088},
	doi = {10.2174/138161210793292474},
	url = {https://www.scopus.com/pages/publications/78649853209?origin=resultslist},
